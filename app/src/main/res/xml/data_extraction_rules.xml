<?xml version="1.0" encoding="utf-8"?><!--
   Backup / device-transfer rules for API 31+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
           ffmpeg-bin is regenerated from the APK on every launch (see FfmpegBinaries).
           Backing it up would either ship ~30MB of binaries to cloud backup or restore
           symlinks pointing at a nativeLibraryDir path that no longer exists.
        -->
        <exclude domain="file" path="ffmpeg-bin" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="ffmpeg-bin" />
    </device-transfer>
</data-extraction-rules>
